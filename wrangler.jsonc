{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nightcastworks",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/dashboard.html"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nightcastdb",
      "database_id": "58662883-33c3-4947-88f8-eeafae7aeada"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "SMS_RATE_LIMIT",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      "name": "OTP_RATE_LIMIT",
      "namespace_id": "1003",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "OIDC_RATE_LIMIT",
      "namespace_id": "1004",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],

  "secrets": {
    "required": [
      "SESSION_SECRET",
      "AUDIT_HASH_SECRET"
    ]
  }
}